<Project>
  <PropertyGroup>
    <Version>2.1.0</Version>
    <Authors>Ehsan Rashidi</Authors>
    <Copyright>Copyright (c) 2025 Ehsan Rashidi</Copyright>
    <Description>Path-based authorization middleware for .NET. Define access rules per resource type using path patterns, and evaluate them against caller claims and operations.</Description>
    <PackageTags>authorization;middleware;aspnetcore;dotnet;access-control;path-matching</PackageTags>
    <PackageProjectUrl>https://github.com/FlameOfUdun/winche-sentinel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FlameOfUdun/winche-sentinel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>